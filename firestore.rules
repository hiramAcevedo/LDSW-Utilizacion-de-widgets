rules_version = '2';

// Reglas de Cloud Firestore del catálogo de películas (IH732, actividad 3.7).
// Cualquiera puede leer el catálogo y agregar una película con sus seis campos
// y sus tipos; nadie la modifica ni la borra hasta que la app tenga inicio de
// sesión y administración (producto integrador).
service cloud.firestore {
  match /databases/{database}/documents {

    function esPeliculaValida(datos) {
      let campos = ['titulo', 'anio', 'director', 'genero', 'color', 'creada'];
      return datos.keys().hasOnly(campos)
        && datos.keys().hasAll(campos)
        && datos.titulo is string && datos.titulo.size() > 0 && datos.titulo.size() <= 200
        && datos.anio is int && datos.anio >= 1888 && datos.anio <= request.time.year() + 1
        && datos.director is string && datos.director.size() > 0 && datos.director.size() <= 200
        && datos.genero is string && datos.genero.size() > 0 && datos.genero.size() <= 50
        && datos.color is int
        && datos.creada == request.time;
    }

    match /peliculas/{pelicula} {
      allow read: if true;
      allow create: if esPeliculaValida(request.resource.data);
      allow update, delete: if false;
    }
  }
}
